# Frontend
# URL pública do Worker Cloudflare (ex: https://gestprop-api.seu-usuario.workers.dev)
# Sem esta variável o app opera em modo local (localStorage/Firebase) e a IA fica desativada.
VITE_API_URL=

# Firebase (legado — persistência local/nuvem do modo offline)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Worker (worker/.dev.vars para desenvolvimento local — NÃO commitar):
# DEEPSEEK_API_KEY=sk-...        # chave da API DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_MODEL=deepseek-v4-pro # modelo padrão (fallback: deepseek-v4-flash);
#                                # os legados deepseek-chat/deepseek-reasoner foram descontinuados em 24/07/2026
# AUTH_SECRET=segredo-long-aleatorio
